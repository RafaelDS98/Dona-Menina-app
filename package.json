{
  "name": "dona-menina",
  "version": "1.0.0",
  "description": "Dona Menina Beauty Bar — Sistema de Gestao",
  "main": "electron/main.cjs",
  "scripts": {
    "electron:dev": "electron .",
    "electron:build": "npm run frontend:build && electron-builder",
    "frontend:build": "cd frontend && npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^35",
    "electron-builder": "^26"
  },
  "build": {
    "appId": "com.donamenina.beautybar",
    "productName": "Dona Menina Beauty Bar",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "backend/**",
      "frontend/dist/**",
      "!**/node_modules/.cache"
    ],
    "extraResources": [
      { "from": "backend/database/schema.sql", "to": "schema.sql" },
      { "from": "backend/database/seed.sql", "to": "seed.sql" }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    },
    "dmg": {
      "artifactName": "DonaMenina-${version}.dmg"
    },
    "win": {
      "target": "portable",
      "icon": "electron/icon.ico"
    },
    "portable": {
      "artifactName": "DonaMenina-${version}.exe"
    }
  }
}
